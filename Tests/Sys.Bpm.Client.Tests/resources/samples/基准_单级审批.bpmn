<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="benchmark-single" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <!-- 基准场景：单级审批。单个审批节点，按 name 集合分配一个审批人。 -->
  <bpmn2:process id="Bench_SingleApproval" name="基准_单级审批" isExecutable="true">
    <bpmn2:startEvent id="Start_Single">
      <bpmn2:outgoing>Flow_Single_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_Single_1" sourceRef="Start_Single" targetRef="Task_Single_Approve" />
    <bpmn2:userTask id="Task_Single_Approve" name="审批" camunda:assignee="${approver}">
      <bpmn2:incoming>Flow_Single_1</bpmn2:incoming>
      <bpmn2:multiInstanceLoopCharacteristics camunda:collection="${name}" camunda:elementVariable="approver">
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${nrOfActiveInstances==0}</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
  </bpmn2:process>
</bpmn2:definitions>
