<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:qh="https://sys.workflow/qhflow"
  id="Definitions_BusinessRuleTaskDecisionBinding"
  targetNamespace="https://sys.workflow/tests"
  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_BusinessRuleTaskDecisionBinding" name="规则任务决策绑定流程" isExecutable="true">
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_RuleApprove" />
    <bpmn2:businessRuleTask id="Activity_RuleApprove" name="审批规则判断" camunda:resultVariable="dmnResult">
      <bpmn2:extensionElements>
        <qh:decisionBinding decisionKey="expense.approval" decisionName="费用审批规则" decisionType="DecisionTable" versionTag="v1.2.0" bindingMode="FixedVersion" executionMode="Sync" traceEnabled="true" fallbackPolicy="ManualIntervention" timeoutMs="3000">
          <qh:inputMappings>
            <qh:inputMapping inputName="amount" sourceType="processVariable" sourceValue="Amount" />
            <qh:inputMapping inputName="channel" sourceType="constant" sourceValue="web" />
            <qh:inputMapping inputName="deptId" sourceType="contextPath" sourceValue="initiator.deptId" />
          </qh:inputMappings>
          <qh:outputMappings>
            <qh:outputMapping outputName="approved" targetType="processVariable" targetValue="approved" />
            <qh:outputMapping outputName="nextAssignee" targetType="processVariable" targetValue="nextAssignee" />
          </qh:outputMappings>
          <qh:option name="manualIntervention.variableName" value="manualReviewContext" />
          <qh:option name="manualIntervention.errorCode" value="DMN_REVIEW_REQUIRED" />
          <qh:option name="manualIntervention.errorMessage" value="规则执行失败，请转人工复核。" />
        </qh:decisionBinding>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Activity_RuleApprove" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
