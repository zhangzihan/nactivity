{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "WorkflowDataSource": {
    "providerName": "Microsoft.Data.SqlClient",
    "database": "DEVDB",
    "connectionString": "server=localhost;database=DEVDB;Integrated Security=True;;PoolBlockingPeriod=NeverBlock;Encrypt=True;TrustServerCertificate=True;"
  },
  "BaseUrl": "http://localhost:11015/",
  "ExternalConnectorUrl": {
    "MailServiceUrl": "ConfigUtil.Value('BaseUrl') + 'mail/send'",
    "WechatServiceUrl": "ConfigUtil.Value('BaseUrl') + 'wechat/send'",
    "SmsServiceUrl": "ConfigUtil.Value('BaseUrl') + 'sms/send'",
    "WorkflowUrl": "ConfigUtil.Value('BaseUrl')",
    "GetUserByDept": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'",
    "GetUserByUser": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'",
    "GetUser": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers/user'",
    "GetUserByDeptLeader": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'",
    "GetUserByDirectReporter": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'",
    "GetUserByDuty": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'",
    "GetUserByUnderling": "ConfigUtil.Value('BaseUrl') + 'api/workflowusers'"
  },
  "AllowedHosts": "*",
  "ConfigFile": "activiti.cfg.json",
  "CacheOptions": {
    "Type": "Sys.Core.Cache.InMemoryCache,Sys.Bpm.Engine",
    "Options": {
      "InMemory": {
        "SizeLimit": -1,
        "AbsoluteExpiration": -1
      }
    }
  }
}
